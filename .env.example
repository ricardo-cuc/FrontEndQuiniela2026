# .env.example - Plantilla para desarrollo/producción
# Copiar este archivo a .env y llenar con valores reales

# Entorno
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Base de datos
DB_HOST=localhost
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=quiniela_db

# Seguridad
JWT_SECRET=tu_jwt_secret_minimo_32_caracteres
API_KEY=tu_api_key_secreta

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=200

# Logs
LOG_LEVEL=info